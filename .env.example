# ==============================================================================
# Mantis Defect Tracking Platform - Environment Configuration Example
# Copy this file to .env.local in apps/web/ or root directory
# ==============================================================================

# 1. PostgreSQL Database URL (Optional - in-memory pg-mem fallback used if omitted)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mantis"

# 2. Google Gemini AI API Key (Optional - for AI Automated Triage Analysis)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# 3. Google OAuth 2.0 (Optional - automatic dev mock active if omitted)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: http://localhost:3000/api/v1/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 4. GitHub OAuth (Optional - automatic dev mock active if omitted)
# Create OAuth app at: https://github.com/settings/developers
# Authorization Callback URL: http://localhost:3000/api/v1/oauth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# 5. GitHub SCM Webhook Secret (Optional)
GITHUB_WEBHOOK_SECRET="mantis-webhook-secret-dev"

# 6. Session Signing Secret (Required in production)
SESSION_SECRET="mantis-session-secret-change-me-in-production-12345"

# 7. Next.js Public URL
NEXT_PUBLIC_API_URL=""

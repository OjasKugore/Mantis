# ==============================================================================
# Mantis Platform - Web & Fullstack Environment Configuration (.env.local)
# ==============================================================================

# 1. PostgreSQL Database (Optional - defaults to zero-config in-memory database if omitted)
# Example for Neon PostgreSQL: postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# 2. Google Gemini AI API Key (Optional - for automated AI bug root-cause analysis & triage)
# Get one for free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. GitHub OAuth Credentials (Optional - dev mock mode active by default)
# Create an OAuth app at: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 4. Google OAuth Credentials (Optional - dev mock mode active by default)
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 5. GitHub SCM Push Webhook Secret (Optional)
GITHUB_WEBHOOK_SECRET=dev-github-webhook-secret

# 6. Session Secret (Optional - 32+ char random string)
SESSION_SECRET=change-me-in-production-min-32-chars-secret-key-12345

# ─── Mantis API — Environment Variables Example ───────────────────────────────
# Copy this file to .env and fill in the required values.

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mantis:mantis@localhost:5432/mantis_dev

# ─── Session ──────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-random-32-char-secret-in-production

# ─── URLs ─────────────────────────────────────────────────────────────────────
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── OAuth: GitHub ────────────────────────────────────────────────────────────
# 1. Go to: https://github.com/settings/developers
# 2. Click "New OAuth App"
# 3. Set:
#    - Application name: Mantis (local)
#    - Homepage URL: http://localhost:3000
#    - Authorization callback URL: http://localhost:3001/api/v1/oauth/github/callback
# 4. Copy the Client ID and Client Secret below.
# Without these, the app falls back to a safe mock GitHub login for development.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── OAuth: Google ────────────────────────────────────────────────────────────
# 1. Go to: https://console.cloud.google.com/
# 2. Create a new OAuth 2.0 Client ID (Web Application)
# 3. Set Authorized redirect URI: http://localhost:3001/api/v1/oauth/google/callback
# 4. Copy the Client ID and Client Secret below.
# Without these, the app falls back to a safe mock Google login for development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── AI / Gemini ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV=development

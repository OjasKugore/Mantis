{
  "name": "mantis-revamp",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "setup": "npm run preflight && docker compose up -d db && node -e \"setTimeout(()=>{},5000)\" && npm run migrate && npm run seed",
    "dev:api": "npm --prefix apps/api run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web run start",
    "test": "npm --prefix apps/web test",
    "test:unit": "npm --prefix apps/web run test",
    "test:integration": "npm --prefix apps/web run test",
    "seed": "npm --prefix apps/api run seed",
    "migrate": "npm --prefix apps/api run migrate"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
